{
  "rewrites": [
    { "source": "/adminpanel", "destination": "/adminpanel.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/codes", "destination": "/codes.html" },
    { "source": "/help_list", "destination": "/listhelp.html" },
    { "source": "/pack/firepack", "destination": "/pack/firepack.html" },
    { "source": "/Tower", "destination": "/Tower.html" },
    { "source": "/Tower_:path(.*)", "destination": "/Tower.html" },
    { "source": "/khoahoctunhien9", "destination": "/khoahoctunhien.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/profile/", "destination": "/profile.html" },
    { "source": "/profile_:username", "destination": "/profile.html" },
    { "source": "/Maths", "destination": "/Maths.html" },
    { "source": "/mathematicmaster", "destination": "/mathematicmaster.html" }
  ],
  "headers": [
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/js/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/onemore/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/cutscene/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]}
  ]
}
