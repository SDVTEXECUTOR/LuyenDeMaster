{
  "rewrites": [
    { "source": "/adminpanel", "destination": "/adminpanel.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/Tower", "destination": "/Tower.html" },
    { "source": "/Tower_:path(.*)", "destination": "/Tower.html" },
    { "source": "/khoahoctunhien9", "destination": "/khoahoctunhien.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/profile/", "destination": "/profile.html" },
    { "source": "/profile_:username", "destination": "/profile.html" }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/js/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/onemore/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/cutscene/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
